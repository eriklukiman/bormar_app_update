:'Total Pembayaran',needToPayDifferentMessage:'Total pembayaran dapat berubah sesuai metode pembayaran yang dipilih.',displayQrEvent:'Gunakan Kode QR ini untuk mengikuti acara',displayQrAddOns:'Tunjukkan Kode QR ini kepada petugas',paymentInformation:'Informasi Pembayaran',detailItems:'Detail Item',ensurePayment:'Untuk menyelesaikan pendaftaran event, mohon pastikan anda sudah melunasi pembayaran.',completePaymentBefore:'Selesaikan pembayaran sebelum',paymentSuccessDesc1:'Pembayaran berhasil. Jangan lupa menghadiri',paymentSuccessDesc2:'Sampai jumpa di sana!',applyCouponSuccessTitle:'Berhasil menggunakan kupon',applyCouponSuccessDesc:'Silakan cek kembali detail pendaftaran event Anda.',seeTutorial:'Lihat Panduan',haveQuestion:'Punya pertanyaan seputar pembayaran event?',paymentStatusExpired:'Status pendaftaran Anda sudah tidak berlaku. Apabila Anda masih ingin mengikuti event ini, silakan registrasi kembali.',paymentStatusAddonsExpired:'Status pembelian add ons Anda sudah tidak berlaku. Apabila Anda masih ingin membeli add ons ini, silakan beli kembali.',passBallotStage:'Selamat anda lolos tahap ballot, silahkan lanjutkan ke pembayaran event.',pleaseCompletePayment:'Silahkan selesaikan pembayaran anda sebelum batas pembayaran berakhir',ballotAnnouncement:'Pengumuman hasil ballot akan diinformasikan pada periode pengumuman hasil ballot.',paymentStatusExpiredShort:'Status pembayaran anda sudah expired',qrWillAppear:'QR Code event akan tampil disini',afterYou:'setelah Anda',passedBallot:'lolos ballot',makeAPayment:'melakukan pembayaran',waitingPayment:'Menunggu Pembayaran',paymentExpired:'Pembayaran Expired',waitingBallotResult:'Menunggu hasil ballot',sorryNotPassedBallot:'Maaf anda tidak lolos tahap ballot',choosePaymentMethod:'Pilih Metode Pembayaran',changePaymentMethod:'Ubah Metode Pembayaran',payNow:'Bayar',payNowVia:'Bayar via',choosePaymentMethodDescription:'Silahkan pilih metode pembayaran untuk event ini',payBefore:'Bayar sebelum',confirmPayment:'Konfirmasi Pembayaran',areYouSureWantToUse:'Apakah Anda yakin ingin menggunakan',asYourPaymentMethod:'sebagai metode pembayaran',bankJatengVirtualAccount:'Virtual Account Bank Jateng',viaBankJatengAtm:'Pembayaran melalui ATM Bank Jateng',viaBankJatengAtmSteps:['Masukkan BPD Card/Kartu ATM Bank Jateng dan PIN ATM','Pilih menu \u201cTransfer\u201d','Pilih menu \u201cKe Bank Jateng\u201d','Masukkan nomor virtual account ke kolom rekening tujuan','Pilih "Lanjutkan"','Cermati nominal dan rincian permintaan','Pilih \u201cBayar\u201d untuk lakukan pembayaran','Pilih \u201cRekening Tabungan\u201d','Transaksi sukses dan ATM akan mencetak bukti pembayaran','Dapatkan email konfirmasi pembayaran berhasil setelah transaksi selesai dari Borobudur Marathon'],viaIBankingJateng:'Pembayaran melalui IBanking Bank Jateng',viaIBankingJatengSteps:['Login ke ibanking Bank Jateng di ibanking.bankjateng.co.id','Daftarkan Nomor Virtual Account untuk pembayaran pada menu \u201cTransfer\u201d lalu sub menu \u201cPendaftaran Rek.Tujuan\u201d','Pilih Kode Bank \u201cBank Jateng\u201d dan masukkan No Rekening/Id Billing dan klik \u201cLanjut\u201d','Cermati data Rekening/Id Billing yang tampil. Jika sesuai klik \u201cProses\u201d','Pilih menu \u201cTransfer\u201d lalu sub menu \u201cTransfer Bank Jateng"','Masukkan No. Rekening Tujuan sesuai yang sudah didaftarkan','Masukkan nominal sesuai dengan jumlah yang harus dibayarkan','Tampil inquiry pembayaran untuk melakukan verifikasi kebenaran data','Masukkan OTP (SMS) untuk melanjutkan transaksi','Muncul Notifikasi payment sukses, bukti transaksi dapat dicetak/ tangkap layar','Dapatkan email konfirmasi pembayaran berhasil setelah transaksi selesai dari Borobudur Marathon'],viaBimaMobileBankJateng:'Pembayaran melalui Bima Mobile Bank Jateng',viaBimaMobileBankJatengSteps:['Login ke aplikasi Bima Mobile','Masuk Beranda lalu pilih menu \u201cTransfer\u201d lalu sub menu \u201cke Bank Jateng\u201d','Masukkan Nomor Virtual Account untuk pembayaran ke kolom rekening tujuan, klik lanjut','Masukkan nominal sesuai dengan jumlah yang harus dibayarkan','Masukkan Nomor Referensi berupa nominal bayar','Masukkan Catatan \u201cNama event\u201d Contoh : Bank Jateng Borobudur Marathon','Pilih Jadwal Transaksi \u201cTransfer Sekarang\u201d, klik \u201clanjut\u201d','Tampil inquiry pembayaran untuk melakukan verifikasi kebenaran data, klik \u201ckirim\u201d','Masukkan MPIN Bima Mobile Anda','Muncul Notifikasi payment sukses, bukti transaksi dapat dicetak atau diunduh','Dapatkan email konfirmasi pembayaran berhasil setelah transaksi selesai dari Borobudur Marathon'],viaOtherBanks:'Melalui Bank lain (Mobile Banking, Internet Banking, ATM)',viaOtherBanksSteps:['Masukkan ATM atau login pada Mobile Banking/Internet Banking','Pilih menu "Transfer"','Pilih menu "Antar Bank", gunakan hanya metode transfer online dengan biaya Rp 6.500 sebagai pilihan metode transfer antar Bank','Pilih Bank Tujuan : BPD JAWA TENGAH/ BANK JATENG/ JATENG atau pilih kode bank 113','Masukkan Nomor Virtual Account Pembayaran ke kolom "Rekening Tujuan", kemudian tekan lanjut','Input Nominal sesuai besar nominal yang harus dibayarkan (harus sesuai)','Tampil inquiry/ konfirmasi pembayaran untuk melakukan verifikasi kebenaran data','Pilih "bayar/kirim" untuk melakukan pembayaran, masukkan MPIN/PIN','Transaksi sukses dan akan muncul bukti pembayaran','Dapatkan email konfirmasi pembayaran berhasil setelah transaksi selesai dari Borobudur Marathon'],checkPaymentStatus:'Periksa Status Pembayaran',haveAVoucherCode:'Punya Kode Voucher?',haveAVoucherCodeDesc:'Masukkan kode voucher Anda di bawah ini untuk menukarkannya.',viaSaveDuitBankJatengTitle:'ATM Bank Jateng',viaSaveDuitBankJatengSteps:['Masukkan Kartu BPD Card ke mesin ATM Bank Jateng','Pilih menu "Pembelian"','Pilih menu "Lainnya"','Masuk menu Saveduit/Borobudur Marathon; Pilih "Lanjut"','Masukkan "Nomor Saveduit" pada kolom "kode bayar", pilih "benar"','Transaksi di Proses','Cermati nominal dan rincian permintaan','Pilih "Bayar"','Transaksi telah berhasil, resi terbit','Selesai','Kunci saldo Anda telah berhasil'],viaSaveDuitIBankingJatengTitle:'Ibanking Bank Jateng',viaSaveDuitIBankingJatengSteps:['Login di ibanking.bankjateng.co.id','Pilih menu pembelian','Pilih menu \u201cReward Tiket\u201d','Masuk ke form Pembelian Reward Saveduit','Masukkan \u201cNomor Saveduit\u201d pada kolom \u201cID Billing\u201d','Pilih Lanjut','Cermati nominal dan rincian permintaan','Masukkan Pin (SMS)/ OTP (SMS)','Pilih \u201cproses\u201d','Terbit notifikasi berhasil','Selesai','Kunci saldo Anda telah berhasil.'],viaSaveDuitBimaMobileTitle:'Bima Mobile',viaSaveDuitBimaMobileSteps:['Login di Bima Mobile','Pilih menu Beli Bayar','Pilih menu "Saveduit"','Masukkan "Nomor Saveduit" pada kolom "ID. Billing"','Pilih Lanjut','Cermati nominal dan rincian permintaan','Pilih "Lanjut"','Masukkan MPIN','Terbit resi transaksi berhasil diterima','Selesai','Kunci saldo Anda telah berhasil'],confirmBlockedStatus:'Konfirmasi Status Blokir',confirmBlockedStatusViaIBanking:'Melalui Ibanking Bank Jateng',confirmBlockedStatusViaIBankingSteps:['Login ke ibanking.bankjateng.co.id','Pilih menu \u201cinformasi rekening\u201d','Pilih menu \u201csaldo mutasi\u201d','Pilih \u201cdetail\u201d','Cermati kolom \u201csaldo blokir\u201d','Akan tertera saldo yang telah terblokir','Selesai'],confirmBlockedStatusViaCustomerService:'Melalui Customer Service',confirmBlockedStatusViaCustomerServiceSteps:['Dengan datang ke kantor Bank Jateng terdekat dengan membawa buku Tabungan dan Kartu BPD Card'],confirmBlockedStatusViaBimaMobile:'Melalui Bima Mobile',confirmBlockedStatusViaBimaMobileSteps:['Dengan menangkap layar resi transaksi berhasil Saveduit yang sudah dilakukan sebagai bukti berhasil transaksi',"Dengan membuka ikon 'notifikasi' (gambar lonceng) pada halaman beranda, lalu pilih 'inbox', dan temukan list transaksi \u201cpembelian Saveduit\u201d. Maka resi transaksi akan muncul kembali."],productPrice:'Harga Produk',additionalFee:'Biaya Tambaha